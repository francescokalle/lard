// Snippet for ~/.config/niri/config.kdl
// (do not paste it if you already have these binds: adapt them instead)

spawn-at-startup "lard"

binds {
    Mod+D       { spawn "lard" "ipc" "launcher"; }
    Mod+Shift+E { spawn "lard" "ipc" "control-center"; }
    Mod+Escape  { spawn "lard" "lock"; }
    Mod+Shift+Q { spawn "lard" "ipc" "quit"; }
    Mod+Shift+R { spawn "lard" "ipc" "reload"; }

    XF86AudioRaiseVolume  { spawn "lard" "ipc" "volume-up"; }
    XF86AudioLowerVolume  { spawn "lard" "ipc" "volume-down"; }
    XF86AudioMute         { spawn "lard" "ipc" "toggle-mute"; }
    XF86MonBrightnessUp   { spawn "lard" "ipc" "brightness-up"; }
    XF86MonBrightnessDown { spawn "lard" "ipc" "brightness-down"; }
}

// The bar reserves space through its exclusive zone; no window rule is needed.
// If your niri version exposes ext-background-effect-v1 the bar gets the
// compositor blur; otherwise the glass/alpha fallback applies.
