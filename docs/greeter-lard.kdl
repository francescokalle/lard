// /etc/lard/greeter.kdl
// Config minima per usare niri come compositore ospite del greeter.
// greetd deve lanciare: niri --config /etc/lard/greeter.kdl
// (utente greeter). Quando il greeter autentica ed esce, anche niri deve uscire:
// per questo dopo lard greeter invochiamo `niri msg action quit`.
// Verifica la sintassi di `spawn-sh-at-startup` e del comando quit sulla tua
// versione di niri.

input {
    keyboard {
        xkb { layout "us" }
    }
}

spawn-at-startup "sh" "-c" "lard greeter; niri msg action quit --skip-confirmation"

// Nessuna bind di sistema: la sola UI è il greeter.
