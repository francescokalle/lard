// /etc/lard/greeter.kdl
// Minimal config to use niri as the host compositor for the greeter.
// greetd must launch: niri --config /etc/lard/greeter.kdl
// (user greeter). When the greeter authenticates and exits, niri must exit too:
// that is why `niri msg action quit` follows lard greeter.
// Check the syntax of `spawn-sh-at-startup` and the quit command on your niri
// version.

input {
    keyboard {
        xkb { layout "us" }
    }
}

spawn-at-startup "sh" "-c" "lard greeter; niri msg action quit --skip-confirmation"

// No system binds: the greeter is the only UI.
