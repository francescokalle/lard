# /etc/pam.d/lard-greeter
#
# Usato dal lockscreen (lard lock) per riautenticare l'utente già
# loggato. Non viene usato per il login: quello passa da greetd, che applica
# il proprio stack PAM (tipicamente /etc/pam.d/greetd o login).
#
# Solo `auth`: deliberatamente niente `account`. Un lockscreen gira come
# l'utente e su un /etc/shadow standard non può leggere la scadenza password;
# pam_unix(account) fallirebbe e il lock resterebbe bloccato per sempre.
# La policy di account (scadenza, orari, faillock) va applicata al login.

auth      required   pam_unix.so
