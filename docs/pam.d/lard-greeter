# /etc/pam.d/lard-greeter
#
# Used by the lockscreen (lard lock) to re-authenticate the user who is already
# logged in. It is not used for login: that goes through greetd, which applies
# its own PAM stack (usually /etc/pam.d/greetd or login).
#
# `auth` only: deliberately no `account`. A lockscreen runs as the user and on a
# standard /etc/shadow it cannot read the password expiry; pam_unix(account)
# would fail and the lock would stay stuck forever. The account policy (expiry,
# time windows, faillock) belongs to the login path.

auth      required   pam_unix.so
