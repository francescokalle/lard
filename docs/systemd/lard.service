# Optional user service. niri usually starts the shell with `spawn-at-startup`,
# which inherits WAYLAND_DISPLAY and NIRI_SOCKET. If you use systemd, import the
# environment before starting it:
#   systemctl --user import-environment WAYLAND_DISPLAY NIRI_SOCKET XDG_RUNTIME_DIR
#   systemctl --user start lard.service
[Unit]
Description=lard desktop shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lard
Restart=on-failure
RestartSec=2
# 78 = EX_CONFIG: no Wayland compositor (e.g. the shell started before niri).
# Without this line the service would retry every 2 s forever.
RestartPreventExitStatus=78
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
