# Servizio utente opzionale. niri di solito avvia la shell con
# `spawn-at-startup`, che eredita WAYLAND_DISPLAY e NIRI_SOCKET.
# Se usi systemd, importa l'ambiente prima di avviarlo:
#   systemctl --user import-environment WAYLAND_DISPLAY NIRI_SOCKET XDG_RUNTIME_DIR
#   systemctl --user start lard.service
[Unit]
Description=lard desktop shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lard
Restart=on-failure
RestartSec=2
# 78 = EX_CONFIG: nessun compositore Wayland (es. shell avviata prima di niri).
# Senza questa riga il servizio riprova ogni 2 s all'infinito.
RestartPreventExitStatus=78
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
