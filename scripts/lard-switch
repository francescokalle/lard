#!/usr/bin/env bash
# Manage the LARD desktop shell on niri.
#
# DankMaterialShell (DMS) is not installed any more: the niri compositor and
# greetd are never stopped, only the user shell service is managed. The niri
# configuration fragments live in ~/.config/niri/lard.
set -u

USER_NAME="$(id -un)"
UID_NUM="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID_NUM}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
MAIN_CONFIG="$CONFIG_DIR/config.kdl"
RUST_DIR="$CONFIG_DIR/lard"
RUST_BINDS="$RUST_DIR/binds.kdl"
RUST_CONFIG="$CONFIG_DIR/config-lard.kdl"
NIRI_SERVICE="lard.service"

log() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31merrore:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
lard-switch — gestisce la shell LARD su niri

USO
  lard-switch status         mostra lo stato dei servizi
  lard-switch start          avvia la shell LARD
  lard-switch restart        riavvia la shell LARD
  lard-switch prepare        rigenera e valida ~/.config/niri/config-lard.kdl
  lard-switch default-rust   imposta LARD come shell predefinita al login

I frammenti di configurazione di niri stanno in ~/.config/niri/lard, le bind
della shell in ~/.config/niri/lard/binds.kdl e la config alternativa in
~/.config/niri/config-lard.kdl.
EOF
}

need_env() {
    if [ -z "${NIRI_SOCKET:-}" ]; then
        NIRI_SOCKET="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'niri.wayland-*.sock' -print -quit 2>/dev/null)"
        export NIRI_SOCKET
    fi
    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        WAYLAND_DISPLAY="$(ls -1 "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | head -n1)"
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY##*/}"
        export WAYLAND_DISPLAY
    fi
    [ -n "$NIRI_SOCKET" ] && [ -S "$NIRI_SOCKET" ] || die "NIRI_SOCKET non trovata (niri è in esecuzione?)"
    [ -n "$WAYLAND_DISPLAY" ] || die "WAYLAND_DISPLAY non trovata"
    command -v niri >/dev/null 2>&1 || die "niri non installato"
}

is_active() {
    systemctl --user is-active --quiet "$1"
}

# The niri configuration is shared: only the include paths change, so the
# window management fragments keep working without DMS.
generate_config() {
    [ -f "$MAIN_CONFIG" ] || die "config niri non trovata: $MAIN_CONFIG"
    [ -d "$RUST_DIR" ] || die "frammenti LARD non trovati in $RUST_DIR"
    [ -f "$RUST_BINDS" ] || die "bind LARD non trovate in $RUST_BINDS"
    sed 's|include "dms/|include "lard/|g' "$MAIN_CONFIG" > "$RUST_CONFIG.tmp"
    mv "$RUST_CONFIG.tmp" "$RUST_CONFIG"
    niri validate -c "$RUST_CONFIG" >/tmp/lard-validate.log 2>&1 || {
        cat /tmp/lard-validate.log >&2
        rm -f "$RUST_CONFIG"
        die "la config niri generata non è valida"
    }
    ok "config LARD generata e validata: $RUST_CONFIG"
}

start_lard() {
    systemctl --user start "$NIRI_SERVICE"
}

stop_lard() {
    systemctl --user stop "$NIRI_SERVICE"
}

show_status() {
    echo "LARD        : $(systemctl --user is-active "$NIRI_SERVICE" 2>/dev/null || true)"
    echo "DMS         : non installato"
    echo "niri        : $(systemctl --user is-active niri.service 2>/dev/null || true)"
    echo "config      : $MAIN_CONFIG"
    echo "config lard : $RUST_CONFIG"
    echo "bind        : $RUST_BINDS"
    echo "socket      : $XDG_RUNTIME_DIR/lard.sock"
}

set_default_rust() {
    need_env
    generate_config
    local unit
    unit="$(systemctl --user show -p FragmentPath --value "$NIRI_SERVICE" 2>/dev/null)"
    [ -n "$unit" ] || die "unit $NIRI_SERVICE non trovata"
    local wants="$HOME/.config/systemd/user/niri.service.wants"
    mkdir -p "$wants" "$HOME/.config/systemd/user/niri.service.d"
    rm -f "$wants/dms.service" "$wants/lard.service"
    ln -sf "$unit" "$wants/lard.service"
    cat > "$HOME/.config/systemd/user/niri.service.d/10-lard.conf" <<EOF
[Service]
Environment=NIRI_CONFIG=$RUST_CONFIG
EOF
    systemctl --user daemon-reload
    ok "default login: niri + LARD ($RUST_CONFIG)"
}

case "${1:-status}" in
    rust|start) start_lard ;;
    stop) stop_lard ;;
    restart)
        systemctl --user restart "$NIRI_SERVICE"
        ok "LARD riavviata"
        ;;
    toggle)
        if is_active "$NIRI_SERVICE"; then
            stop_lard
        else
            start_lard
        fi
        ;;
    status) show_status ;;
    prepare) need_env; generate_config ;;
    default-rust) set_default_rust ;;
    dms|dank|default-dms) die "DankMaterialShell non è più installato" ;;
    -h|--help|help) usage ;;
    *) usage; exit 2 ;;
esac
